# Required for contact form delivery. Keep these values server-side.
RESEND_API_KEY=
# Use a sender address on a domain verified in Resend.
# Example: Portfolio <portfolio@your-domain.com>
CONTACT_FROM_EMAIL=

# Required Google Drive sharing links for resume downloads. No fallback is used.
# Nigerian visitors receive RESUME_NG_URL. Other visitors receive RESUME_REMOTE_URL.
RESUME_NG_URL=
RESUME_REMOTE_URL=

# Do not add NEXT_PUBLIC_ prefixes to these variables.
